#!/usr/bin/env python

import os
from pathlib import Path
import subprocess
import sys

command = [sys.executable, "-m", "sphinx"]
if os.environ.get("AMSBIN"):
    command = ["sh", str(Path(os.environ["AMSBIN"]) / "amspython"), "-m", "sphinx"]

location = Path(__file__).resolve().parent
source = location / "source"
target = Path(sys.argv[1]) if len(sys.argv) > 1 else location / "build"

sys.exit(subprocess.call([*command, str(source), str(target), "-W", "-w", "build_plams_doc_warn_errors.txt"]))
